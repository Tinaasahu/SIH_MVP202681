# Backend & Database Environment Variables Template
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env

# Flask Server Port
PORT=5001
FLASK_ENV=development

# Supabase Sync (Optional: used by database/push_to_supabase.py)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET=your_supabase_secret_key_here
